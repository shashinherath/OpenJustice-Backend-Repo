# ─────────────────────────────────────────────────────────────────────────────
# OpenJustice Backend — Production Environment Variables Template
#
# Copy this file to .env.production and fill in the values.
# In Azure, set ALL of these as Container App Environment Variables
# (or reference Azure Key Vault secrets).
#
# NEVER commit a filled-in .env file to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=OpenJustice Backend
APP_VERSION=0.1.0
DEBUG=False
ENVIRONMENT=production

# ── Database ──────────────────────────────────────────────────────────────────
# Azure Database for PostgreSQL — Flexible Server connection string.
# SSL is required (enforced automatically in db/base.py when DEBUG=False).
# Format: postgresql+asyncpg://<user>@<server>:<password>@<host>:5432/<dbname>
DATABASE_URL=postgresql+asyncpg://openjustice_user:CHANGE_ME@your-server.postgres.database.azure.com:5432/openjustice
DB_ECHO=False
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
# Store in Azure Key Vault and reference as a Key Vault secret reference.
SECRET_KEY=CHANGE_ME_USE_OPENSSL_RAND_HEX_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_ISSUER=openjustice
JWT_AUDIENCE=openjustice-api
AUTH_COOKIE_NAME=access_token
# Use 'lax' if on same root domain, 'none' for cross-origin (requires Secure=True)
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_SECURE=True

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-CHANGE_ME
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_MAX_TOKENS=1200
OPENAI_TEMPERATURE=0.2

# ── Whisper / TTS ─────────────────────────────────────────────────────────────
WHISPER_MODEL=gpt-4o-mini-transcribe
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=alloy

# ── Audio Storage ─────────────────────────────────────────────────────────────
# NOTE: These directories are ephemeral on Azure Container Apps.
# Files are lost on container restart. Migrate to Azure Blob Storage for persistence.
AUDIO_TEMP_DIR=temp/audio
AUDIO_MEDIA_DIR=media/audio
AUDIO_RETENTION_MINUTES=60

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for the frontend.
CORS_ORIGINS=["https://your-frontend.azurestaticapps.net","https://app.openjustice.lk"]

# ── Public URL ────────────────────────────────────────────────────────────────
# Your Azure Container App / App Service public URL.
# Used by Twilio to fetch audio files for WhatsApp voice notes.
PUBLIC_BASE_URL=https://your-backend.azurecontainerapps.io

# ── Twilio / WhatsApp ─────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=CHANGE_ME
TWILIO_AUTH_TOKEN=CHANGE_ME
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
