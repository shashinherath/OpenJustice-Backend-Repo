    {
      "name": "Chat",
      "item": [
        {
          "name": "Create Conversation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer <YOUR_ACCESS_TOKEN>",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"title\": \"New Case Inquiry\",\r\n  \"channel\": \"web\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{webUrl}}/api/chats",
              "host": [
                "{{webUrl}}"
              ],
              "path": [
                "api",
                "chats"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get Conversations",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer <YOUR_ACCESS_TOKEN>",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{webUrl}}/api/chats?skip=0&limit=100",
              "host": [
                "{{webUrl}}"
              ],
              "path": [
                "api",
                "chats"
              ],
              "query": [
                {
                  "key": "skip",
                  "value": "0"
                },
                {
                  "key": "limit",
                  "value": "100"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get Conversation Detail",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer <YOUR_ACCESS_TOKEN>",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{webUrl}}/api/chats/{{conversation_id}}",
              "host": [
                "{{webUrl}}"
              ],
              "path": [
                "api",
                "chats",
                "{{conversation_id}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Add Message",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer <YOUR_ACCESS_TOKEN>",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"content\": \"Hello, I need legal help.\",\r\n  \"sender\": \"user\",\r\n  \"message_type\": \"text\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{webUrl}}/api/chats/{{conversation_id}}/messages",
              "host": [
                "{{webUrl}}"
              ],
              "path": [
                "api",
                "chats",
                "{{conversation_id}}",
                "messages"
              ]
            }
          },
          "response": []
        }
      ]
    },
