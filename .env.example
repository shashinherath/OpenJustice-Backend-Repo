# Application
APP_NAME=OpenJustice Backend
APP_VERSION=0.1.0
DEBUG=True

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/open_justice
DB_ECHO=False
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Security
SECRET_KEY=your-secret-key-change-this-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_ISSUER=openjustice
JWT_AUDIENCE=openjustice-api
AUTH_COOKIE_NAME=access_token
AUTH_COOKIE_SAMESITE=strict
# Leave unset to use: DEBUG=True -> False, DEBUG=False -> True
AUTH_COOKIE_SECURE=

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_MAX_TOKENS=4096
OPENAI_TEMPERATURE=0.7

# Whisper (Speech-to-Text)
WHISPER_MODEL=whisper-1

# TTS (Text-to-Speech)
TTS_MODEL=tts-1
TTS_VOICE=alloy

# AWS S3 (Optional - for production storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=

# MinIO (Optional - for local storage)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=openjustice
MINIO_SECURE=False

# WhatsApp - Twilio (Optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=

# WhatsApp - Meta Cloud API (Optional)
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_VERIFY_TOKEN=

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# File Upload
MAX_UPLOAD_SIZE=10485760
ALLOWED_AUDIO_FORMATS=["mp3","wav","ogg","m4a"]
ALLOWED_DOCUMENT_FORMATS=["pdf","txt","docx"]

# RAG Settings
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
VECTOR_SEARCH_TOP_K=5
